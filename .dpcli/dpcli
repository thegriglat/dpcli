#!/usr/bin/env python3
"""dpcli — journal, task cards and module acceptance. Entry point: the package lives in lib/dpcli next to this file."""
import sys
from pathlib import Path

if sys.version_info < (3, 10):
    sys.exit("dpcli: requires Python >= 3.10")
sys.dont_write_bytecode = True  # no __pycache__ inside .dpcli: copies stay clean for git
sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from dpcli.cli import main  # noqa: E402

main()
